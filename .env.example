# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables instead (never commit .env).

# Server-only: used by the /api routes (Gemini Vision triage and advisory AI).
# Without it the app still works and the AI features fall back to safe defaults.
GEMINI_API_KEY=

# Optional: Supabase project. Without these the app runs on its seeded local demo store.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
